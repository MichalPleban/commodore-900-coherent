# ZView launchable applications, read by zview at startup.
# One line per app:  name:execpath:multi
#   name        menu label
#   execpath    program; run with a bare argv (no window arguments)
#   multi       1 = may open many (launcher shows "New <name>...");
#               0 = single instance (launcher shows "<name>..."; re-launch raises it)
#
# The window itself -- title, size, icon, whether it may be stretched -- is NOT
# configured here: the application declares it at start-up (hr_open, see
# inc/hrapp.h), so a program can also be run straight from a shell.
#
# This is the LAUNCHER MENU only.  What comes up when the desktop starts is a
# separate thing: the shell script /usr/hr/etc/rc, which is also where an app's
# position/size/minimised options go (an entry here is run with a bare argv).
Shell:/usr/hr/bin/zterm:1
Editor:/usr/hr/bin/zedit:1
Clock:/usr/hr/bin/zclock:0
