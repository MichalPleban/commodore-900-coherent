# Vellum symbol library: LOGIC gates and flip-flops.
# Format (see Vellum): quarter-grid units, pins on whole units (mult. of 4).
#   symbol CODE PFX / s x0 y0 x1 y1 / c cx cy r / t x y C / p x y / end
symbol BUF U
s 0 0 4 0
s 4 -4 4 4
s 4 -4 12 0
s 4 4 12 0
s 12 0 16 0
p 0 0
p 16 0
end
symbol NOT U
s 0 0 4 0
s 4 -4 4 4
s 4 -4 12 0
s 4 4 12 0
c 14 0 2
p 0 0
p 16 0
end
symbol AND U
s 0 0 4 0
s 0 8 4 8
s 4 -2 4 10
s 4 -2 10 -2
s 4 10 10 10
s 10 -2 13 0
s 13 0 14 4
s 14 4 13 8
s 13 8 10 10
s 14 4 20 4
p 0 0
p 0 8
p 20 4
end
symbol NAND U
s 0 0 4 0
s 0 8 4 8
s 4 -2 4 10
s 4 -2 10 -2
s 4 10 10 10
s 10 -2 13 0
s 13 0 14 4
s 14 4 13 8
s 13 8 10 10
c 16 4 2
s 18 4 20 4
p 0 0
p 0 8
p 20 4
end
symbol OR U
s 0 0 5 0
s 0 8 5 8
s 4 -2 6 4
s 6 4 4 10
s 4 -2 9 -2
s 9 -2 14 2
s 14 2 16 4
s 4 10 9 10
s 9 10 14 6
s 14 6 16 4
s 16 4 20 4
p 0 0
p 0 8
p 20 4
end
symbol NOR U
s 0 0 5 0
s 0 8 5 8
s 4 -2 6 4
s 6 4 4 10
s 4 -2 9 -2
s 9 -2 14 2
s 14 2 16 4
s 4 10 9 10
s 9 10 14 6
s 14 6 16 4
c 18 4 2
p 0 0
p 0 8
p 20 4
end
symbol XOR U
s 0 0 5 0
s 0 8 5 8
s 4 -2 6 4
s 6 4 4 10
s 2 -2 4 4
s 4 4 2 10
s 4 -2 9 -2
s 9 -2 14 2
s 14 2 16 4
s 4 10 9 10
s 9 10 14 6
s 14 6 16 4
s 16 4 20 4
p 0 0
p 0 8
p 20 4
end
symbol XNOR U
s 0 0 5 0
s 0 8 5 8
s 4 -2 6 4
s 6 4 4 10
s 2 -2 4 4
s 4 4 2 10
s 4 -2 9 -2
s 9 -2 14 2
s 14 2 16 4
s 4 10 9 10
s 9 10 14 6
s 14 6 16 4
c 18 4 2
p 0 0
p 0 8
p 20 4
end
symbol DFF U
s 2 -4 14 -4
s 14 -4 14 12
s 14 12 2 12
s 2 12 2 -4
s 0 0 2 0
s 0 8 2 8
s 14 0 16 0
s 14 8 16 8
s 2 6 5 8
s 5 8 2 10
t 4 -3 D
t 9 -3 Q
t 9 5 Q
s 9 4 12 4
p 0 0
p 0 8
p 16 0
p 16 8
end
symbol JKFF U
s 2 -4 14 -4
s 14 -4 14 20
s 14 20 2 20
s 2 20 2 -4
s 0 0 2 0
s 0 8 2 8
s 0 16 2 16
s 14 0 16 0
s 14 16 16 16
s 2 6 5 8
s 5 8 2 10
t 4 -3 J
t 4 13 K
t 9 -3 Q
t 9 13 Q
s 9 12 12 12
p 0 0
p 0 8
p 0 16
p 16 0
p 16 16
end
symbol SRFF U
s 2 -4 14 -4
s 14 -4 14 12
s 14 12 2 12
s 2 12 2 -4
s 0 0 2 0
s 0 8 2 8
s 14 0 16 0
s 14 8 16 8
t 4 -3 S
t 4 5 R
t 9 -3 Q
t 9 5 Q
s 9 4 12 4
p 0 0
p 0 8
p 16 0
p 16 8
end
