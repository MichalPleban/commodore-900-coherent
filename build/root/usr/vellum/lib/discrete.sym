s 0 0 2 0
s 2 -3 2 3
s 2 -3 6 0
s 2 3 6 0
s 6 -3 6 3
s 6 0 8 0
s 3 -4 5 -7
s 5 -7 4 -7
s 5 -7 5 -6
s 6 -3 8 -6
s 8 -6 7 -6
s 8 -6 8 -5
p 0 0
p 8 0
