# Vellum symbol library: NETWORK-MAP stencils.  Quarter-grid units,
# pins on whole units (multiples of 4).
symbol HOST H
s -8 -8 8 -8
s 8 -8 8 8
s 8 8 -8 8
s -8 8 -8 -8
s -8 -4 8 -4
c -5 -6 1
p 0 -8
p 0 8
p -8 0
p 8 0
end
symbol TERM T
s -8 -8 8 -8
s 8 -8 8 2
s 8 2 -8 2
s -8 2 -8 -8
s -6 -6 6 -6
s -6 -6 -6 0
s 6 -6 6 0
s -6 0 6 0
s -4 2 -4 4
s 4 2 4 4
s -6 4 6 4
p 0 4
p 0 -8
end
symbol PRT P
s -8 -4 8 -4
s 8 -4 8 4
s 8 4 -8 4
s -8 4 -8 -4
s -4 -8 4 -8
s -4 -8 -4 -4
s 4 -8 4 -4
s -6 0 6 0
p 0 4
p 0 -8
end
symbol MDM M
s -8 -4 8 -4
s 8 -4 8 4
s 8 4 -8 4
s -8 4 -8 -4
c -4 0 1
c 0 0 1
c 4 0 1
p -8 0
p 8 0
end
symbol DSK D
a 0 -4 8 0 180
s -8 -4 -8 4
s 8 -4 8 4
a 0 4 8 180 360
a 0 -4 8 180 360
p 0 -12
p 0 12
end
symbol TAP -
s -12 0 12 0
s 0 0 0 8
c 0 0 2
p -12 0
p 12 0
p 0 8
end
symbol GW G
s -8 -8 8 -8
s 8 -8 8 8
s 8 8 -8 8
s -8 8 -8 -8
s -8 -8 8 8
s 8 -8 -8 8
p 0 -8
