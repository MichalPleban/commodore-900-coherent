#	Default actions.

.c.o:
	$(CC) $(CFLAGS) -c $<
.e.o .r.o .f.o:
	$(EC) $(RFLAGS) $(EFLAGS) $(FFLAGS) -c $<
.s.o:
	$(AS) $(ASFLAGS) -o $@ $<
.y.o:
	$(YACC) $(YFLAGS) $<
	$(CC) $(CFLAGS) -c y.tab.c
	rm y.tab.c
	mv y.tab.o $@
.y.c:
	$(YACC) $(YFLAGS) $<
	mv y.tab.c $@
.l.o:
	$(LEX) $(LFLAGS) $<
	$(CC) $(CFLAGS) -c lex.yy.c
	rm lex.yy.c
	mv lex.yy.o $@
.l.c:
	$(LEX) $(LFLAGS) $<
	mv lex.yy.c $@
